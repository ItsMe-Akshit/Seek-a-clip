# ---------------------------------------------------------------------------
# Secrets and local configuration. Never commit these.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
ai.json
storage.json

# ---------------------------------------------------------------------------
# Databases, user data and generated output.
# The real data folder lives outside the repo (see PEAKCUT_DATA in .env).
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
users/
uploads/
output/
outputs/
renders/
tmp/
clips/

# ---------------------------------------------------------------------------
# The speech model is about 652 MB and is downloaded on first start.
# See "Speech model" in README.md.
# ---------------------------------------------------------------------------
models/
*.onnx
*.safetensors
*.bin

# ---------------------------------------------------------------------------
# Caches, virtual environments and installed packages.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
.venv/
venv/
env/
coverage/
htmlcov/
*.log

# ---------------------------------------------------------------------------
# Editors and operating systems.
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Video is ignored by default, but the small example clips that ship with the
# site are included on purpose (10 files, about 2.26 MB in total).
# ---------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
!web/brand/clip-*.mp4
!web/brand/demo-*.mp4
!web/videos/*.mp4
